{
    "name": "@luminnus/lia-runtime",
    "version": "1.0.0",
    "private": true,
    "main": "./src/index.ts",
    "module": "./src/index.ts",
    "types": "./src/index.ts",
    "exports": {
        ".": {
            "types": "./src/index.ts",
            "import": "./src/index.ts",
            "require": "./src/index.ts",
            "default": "./src/index.ts"
        },
        "./live": {
            "types": "./src/live/index.ts",
            "import": "./src/live/index.ts",
            "require": "./src/live/index.ts",
            "default": "./src/live/index.ts"
        },
        "./contracts": {
            "types": "./src/contracts/index.ts",
            "import": "./src/contracts/index.ts",
            "require": "./src/contracts/index.ts",
            "default": "./src/contracts/index.ts"
        },
        "./utils": {
            "types": "./src/utils/index.ts",
            "import": "./src/utils/index.ts",
            "require": "./src/utils/index.ts",
            "default": "./src/utils/index.ts"
        },
        "./version": {
            "types": "./src/version/index.ts",
            "import": "./src/version/index.ts",
            "require": "./src/version/index.ts",
            "default": "./src/version/index.ts"
        },
        "./memory": {
            "types": "./src/memory/index.ts",
            "import": "./src/memory/index.ts",
            "require": "./src/memory/index.ts",
            "default": "./src/memory/index.ts"
        },
        "./persona": {
            "types": "./src/persona.ts",
            "import": "./src/persona.ts",
            "require": "./src/persona.ts",
            "default": "./src/persona.ts"
        },
        "./system": {
            "types": "./system/systemManifest.ts",
            "import": "./system/systemManifest.ts",
            "require": "./system/systemManifest.ts",
            "default": "./system/systemManifest.ts"
        }
    },
    "scripts": {
        "build": "tsup && tsc --emitDeclarationOnly",
        "dev": "tsup --watch",
        "lint": "eslint src/",
        "clean": "rimraf dist",
        "typecheck": "tsc --noEmit"
    },
    "dependencies": {
        "@google/genai": "^1.0.0",
        "@luminnus/shared": "workspace:*"
    },
    "devDependencies": {
        "rimraf": "^5.0.5",
        "tsup": "^8.0.0",
        "typescript": "^5.3.0"
    },
    "peerDependencies": {
        "socket.io-client": "^4.0.0"
    }
}