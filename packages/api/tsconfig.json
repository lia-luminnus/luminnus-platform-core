{
    "compilerOptions": {
        "target": "ES2022",
        "module": "NodeNext",
        "moduleResolution": "NodeNext",
        "lib": [
            "ES2022"
        ],
        "outDir": "./dist",
        "rootDir": "./src",
        "strict": true,
        "esModuleInterop": true,
        "skipLibCheck": true,
        "declaration": true,
        "composite": true,
        "sourceMap": true,
        "baseUrl": ".",
        "paths": {
            "@luminnus/shared": [
                "../shared/dist/index.d.ts"
            ]
        }
    },
    "references": [
        {
            "path": "../shared"
        }
    ],
    "include": [
        "src/**/*"
    ],
    "exclude": [
        "node_modules",
        "dist"
    ]
}