# ===========================================================
# Backend LIA (lia-live-view/server) - ENVs Template
# ===========================================================
# Copie para .env e preencha os valores

# ===========================================================
# SERVIDOR
# ===========================================================
PORT=3000
NODE_ENV=development

# CORS - Lista de origens permitidas (CSV)
# Local: http://localhost:5173,http://localhost:3001
# Produção: https://admin.luminnus.com,https://app.luminnus.com
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3001

# ===========================================================
# SUPABASE
# ===========================================================
SUPABASE_URL=https://pljdfclhomtsazfijwrz.supabase.co
SUPABASE_ANON_KEY=sua_anon_key_aqui
SUPABASE_SERVICE_ROLE_KEY=sua_service_role_key_aqui

# ===========================================================
# OPENAI
# ===========================================================
OPENAI_API_KEY=sua_openai_key_aqui

# ===========================================================
# GEMINI (para Live Mode direto)
# ===========================================================
GEMINI_API_KEY=sua_gemini_key_aqui

# ===========================================================
# TWILIO (Conta Master - Multi-Tenant WhatsApp)
# ===========================================================
TWILIO_ACCOUNT_SID=seu_twilio_account_sid_aqui
TWILIO_AUTH_TOKEN=seu_twilio_auth_token_aqui
TWILIO_API_KEY_SID=seu_twilio_api_key_sid_aqui
TWILIO_API_KEY_SECRET=seu_twilio_api_key_secret_aqui
TWILIO_WEBHOOK_BASE_URL=https://api.luminnus.ai/api/twilio/webhook
TWILIO_ENCRYPTION_KEY=gerar_com_openssl_rand_hex_32
